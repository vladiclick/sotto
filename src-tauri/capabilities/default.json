{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Panel, Settings window and recording overlay: core IPC + events",
  "windows": [
    "panel",
    "overlay",
    "settings"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-hide",
    "core:window:allow-set-size"
  ]
}
